# AffiliBlog environment variables.
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# Public origin of the deployed site, no trailing slash. NOT a secret — it is
# inlined into the client bundle. Required for correct SEO: canonical URLs,
# OG/Twitter image resolution, sitemap.xml and JSON-LD all build on it.
# While unset, robots.txt returns `Disallow: /` so an unconfigured deploy can't
# be indexed by mistake.
NEXT_PUBLIC_SITE_URL=https://affiliblog.example.com

# Local Postgres connection string — what the app uses in development.
# Create the database first:  createdb affiliblog   (or via DBeaver)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/affiliblog

# Hosted Postgres (Neon). Read ONLY by db/migrate-to-neon.mjs, never by the app,
# so local dev can't accidentally write to production. Keeping it separate from
# DATABASE_URL is deliberate.
#
# Use the POOLED endpoint — the host contains `-pooler`. On Vercel this same
# pooled string is what DATABASE_URL must be set to: every warm serverless
# instance holds its own pool, so the direct endpoint exhausts the connection
# limit under mild traffic (see the note in src/lib/db.ts).
NEON_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require

# Long random string the Hermes agent sends as `Authorization: Bearer <key>`.
# Generate with:  [System.Security.Cryptography.RandomNumberGenerator]...
AGENT_API_KEY=replace-with-a-long-random-string

# Amazon Associates tag baked into each product amazonUrl for v1.
AMAZON_AFFILIATE_TAG=affiliblog-21

# Optional for v1. When set, /api/newsletter also forwards to Resend.
# Leave blank to store subscribers in the local newsletter_subscribers table only.
RESEND_API_KEY=
